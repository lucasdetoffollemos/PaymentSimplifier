                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payerId\": \"{{commonUserId}}\",\n  \"payeeId\": \"{{merchantUserId}}\",\n  \"value\": 25.50\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Transfers"
              ]
            },
            "description": "Transfers money from a common user to a merchant."
          }
        },
        {
          "name": "Transfer Common To Common",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"payerId\": \"{{commonUserId}}\",\n  \"payeeId\": \"00000000-0000-0000-0000-000000000000\",\n  \"value\": 10.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Transfers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Transfers"
