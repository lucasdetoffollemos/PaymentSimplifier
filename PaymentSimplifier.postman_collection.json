              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Lucas Silva\",\n  \"document\": \"529.982.247-25\",\n  \"email\": \"lucas@email.com\",\n  \"password\": \"123456\",\n  \"userType\": 1\n}"
            },
            "url": {
