              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Users"
              ]
            },
            "description": "Creates a common user. Use userType 1 for common users."
          }
        },
        {
          "name": "Create Merchant User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Loja XPTO\",\n  \"document\": \"11.222.333/0001-81\",\n  \"email\": \"lojaxpto@email.com\",\n  \"password\": \"123456\",\n  \"userType\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/Users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "Users"
              ]
            },
            "description": "Creates a merchant user. Use userType 2 for merchants."
          }
        },
        {
          "name": "Deposit Into User Account",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
